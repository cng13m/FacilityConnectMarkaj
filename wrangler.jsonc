{
  "name": "facilityconnectmarkaj",
  "keep_vars": true,
  "compatibility_date": "2026-07-22",
  "main": "./worker/index.js",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
